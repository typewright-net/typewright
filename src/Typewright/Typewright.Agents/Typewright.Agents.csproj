<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Typewright agents: a strongly typed, modular mailbox processor (F# MailboxProcessor for C#) with replaceable mailbox, dispatcher, handler, reply channel, failure policy, and interceptor pipeline. No actor system required.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Typewright.Agents.Tests" />
  </ItemGroup>

  <!-- Typewright.Validation is itself BCL-only; it supplies IDomainError and OperationResult. -->
  <ItemGroup>
    <ProjectReference Include="..\Typewright.Validation\Typewright.Validation.csproj" />
    <ProjectReference Include="..\Typewright.Validation.Generators\Typewright.Validation.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
